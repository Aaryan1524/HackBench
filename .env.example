# HackBench Forensics Environment Configuration
# Copy to .env for local development

# Layer 2: Jev System One Decision Engine
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.80

# Layer 3: ChatGPT / OpenAI Synthesis & Ambiguity Engine
CHATGPT_API_KEY=
CHATGPT_MODEL=gpt-5.6-terra
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Networking & Deployment
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
DEBUG=false

# Production only (set these in your hosting platform, never in a committed file)
# HACKBENCH_ENV=production        # disables /docs and /openapi.json
# TRUST_PROXY_HEADERS=true        # only if your platform OVERWRITES X-Forwarded-For with the real client IP; otherwise leave off

# Product analytics (PostHog). Optional: with no key, analytics is a silent no-op.
# These are PUBLIC by design (they ship in the browser bundle). They must be present when `next build` runs.
# Keep them in this same root .env (the frontend config reads only NEXT_PUBLIC_* and BACKEND_URL from it),
# or in your hosting platform's environment settings.
# Never put a PostHog personal/management API key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Local development is off by default. Set to true to test, or false to force off in production.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Deployment (Railway backend + Vercel frontend). Set these in each platform's settings, never in a committed file.
# BACKEND_SHARED_SECRET=            # same random value on both sides (openssl rand -hex 32). Backend refuses /api without it.
# BACKEND_URL=https://your-backend.up.railway.app   # Vercel only: where the frontend proxies /api (read at request time)
# DAILY_ANALYSIS_LIMIT=1500         # Railway: reviews per UTC day before the service pauses (0 = no cap)
# MAX_CONCURRENT_ANALYSES=8         # Railway: reviews allowed to run at the same moment
